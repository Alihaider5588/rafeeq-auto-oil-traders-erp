# ==============================================================================
# RAFIQ AUTO & OIL TRADERS - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate with your production or local secrets.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL.
# ==============================================================================

# Database Connection URL
# For SQLite (Local development):
# DATABASE_URL="file:./prisma/dev.db"
# For PostgreSQL (Cloud/Production: Neon, Supabase, RDS, Railway, etc.):
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public&sslmode=require"

# JSON Web Token Secret (generate a strong 64+ char random string for production)
JWT_SECRET="your_strong_random_jwt_secret_key_here"

# Server Port
PORT=5000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=production

# Allowed Frontend URL for CORS (e.g., https://your-pos-domain.com or http://localhost:5173)
FRONTEND_URL="http://localhost:5173"
