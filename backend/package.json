{
  "name": "rafeeque-oil-traders-backend",
  "version": "1.0.0",
  "description": "Backend API for Rafeeque Oil Traders POS & ERP",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && prisma generate --schema=prisma/schema.postgres.prisma && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:pg:generate": "prisma generate --schema=prisma/schema.postgres.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "jest"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/multer": "^2.3.0",
    "@types/sqlite3": "^3.1.11",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pg": "^8.13.1",
    "prisma": "^5.22.0",
    "sqlite3": "^6.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
